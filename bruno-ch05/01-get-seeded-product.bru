meta {
  name: Get seeded product
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/products/42
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns the seeded product", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(42);
    expect(res.body.name).to.equal("Trail Map Set");
  });
}
