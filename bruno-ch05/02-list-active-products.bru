meta {
  name: List active products
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/products?page=0&size=10&active=true
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns a paged product representation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array").with.lengthOf(1);
    expect(res.body.totalElements).to.equal(1);
    expect(res.body.links.self).to.include("active=true");
  });
}
