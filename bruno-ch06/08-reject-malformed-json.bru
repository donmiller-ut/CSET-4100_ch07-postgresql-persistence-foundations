meta {
  name: Reject malformed JSON
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/products
  body: text
  auth: none
}

headers {
  Accept: application/json, application/problem+json
  Content-Type: application/json
}

body:text {
  {"name":"Broken","price":
}

tests {
  test("returns a safe 400 problem", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("malformed_request");
  });
}
