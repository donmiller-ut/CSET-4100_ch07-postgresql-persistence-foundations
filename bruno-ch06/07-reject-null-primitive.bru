meta {
  name: Reject null active value
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

headers {
  Accept: application/json, application/problem+json
  Content-Type: application/json
}

body:json {
  {
    "name": "Null Active",
    "price": 4.50,
    "active": null
  }
}

tests {
  test("distinguishes omitted active from explicit null", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("malformed_request");
  });
}
