meta {
  name: Reject unknown property
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

headers {
  Accept: application/json, application/problem+json
  Content-Type: application/json
}

body:json {
  {
    "id": 9000,
    "name": "Injected Identifier",
    "price": 4.50
  }
}

tests {
  test("prevents over-posting", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("malformed_request");
    expect(JSON.stringify(res.body)).to.not.include("9000");
  });
}
