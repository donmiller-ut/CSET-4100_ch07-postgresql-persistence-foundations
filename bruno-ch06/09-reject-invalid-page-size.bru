meta {
  name: Reject invalid page size
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/products?size=101
  body: none
  auth: none
}

headers {
  Accept: application/json, application/problem+json
}

tests {
  test("returns a 400 parameter problem", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("invalid_parameter");
  });
}
